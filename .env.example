# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=sqlite:///./local.db
# Production example (Neon):
# DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

ALLOWED_ORIGINS=*
API_URL=http://localhost:8000

# --- Stage 3B: solver budget.
# These bound how long a single run can take. The CP-SAT model is a capacitated
# joint-replenishment problem and will happily use any budget it is given, so
# the limits are what stop a large request from occupying the worker for hours.
# Lower them on a small free-tier instance; a 60-item run at the defaults takes
# roughly three minutes.
MAX_OPTIMISE_ITEMS=40
SOLVER_TIME_LIMIT_S=15
PLANNING_HORIZON_DAYS=14
# A what-if scenario is two full policy runs, so it is capped below the
# optimise cap. Unset, it defaults to half of MAX_OPTIMISE_ITEMS.
MAX_SCENARIO_ITEMS=20

# Added in Stage 3C
# OPENAI_API_KEY=
# GROQ_API_KEY=
